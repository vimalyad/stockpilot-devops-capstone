  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MovementIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Warehouse Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "issue",
              "transfer"
            ],
            "title": "Kind"
          },
          "destination_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "reference": {
            "type": "string",
            "maxLength": 120,
            "title": "Reference",
            "default": ""
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
